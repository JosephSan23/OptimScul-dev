# ─────────────────────────────────────────────────────────────────────────────
# infra/.env.example  →  copiar a  infra/.env  antes del primer `docker compose up`

# Contraseña de PostgreSQL (usuario "optimscul"). En dev debe ser optimscul1234
# porque application-dev.yml apunta a esa clave.
DB_PASSWORD=optimscul1234

# Contraseña de acceso a la consola de pgAdmin (http://localhost:5050).
PGADMIN_PASSWORD=admin1234

# Credenciales del MinIO local (almacenamiento S3). En dev deben ser
# optimscul / optimscul1234 porque application-dev.yml las usa como access-key
# y secret-key del storage.
MINIO_ROOT_USER=optimscul
MINIO_ROOT_PASSWORD=optimscul1234

# Bucket que se crea automáticamente la primera vez.
STORAGE_BUCKET=optimscul

# Secreto para firmar los JWT. Solo lo usa el servicio backend del compose
# (perfil "prod"). En dev el backend usa el secreto de application-dev.yml, así
# que este valor da igual localmente, pero en PRODUCCIÓN pon una cadena larga
# y aleatoria (mín. 32 caracteres) y guárdala de forma segura.
JWT_SECRET=CAMBIAR_EN_PRODUCCION_por_una_cadena_larga_y_aleatoria
